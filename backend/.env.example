# Email Extractor [WMN] Python backend (Flask)
# Copy to .env if you want to override these (loaded by your shell, not required).

# Port the Flask server listens on (default 5000)
#PORT=5000

# Flask debug mode (1 = reload on change, for local dev)
#FLASK_DEBUG=1

# Telegram notification (optional — notifies on successful IMAP test, credentials NOT sent)
#TELEGRAM_BOT_TOKEN=your_bot_token_here
#TELEGRAM_CHAT_ID=your_chat_id_here
